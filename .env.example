# Copy to .env next to compose.yml and adjust.

# The exact origin ChatGPT / Codex / agents use to reach the hub (no path).
# OAuth metadata is derived from it, so it must match the URL you give to clients.
WEBCODER_PUBLIC_URL=http://127.0.0.1:8787

# Domain for the HTTPS override (deploy/compose.https.yml); sets WEBCODER_PUBLIC_URL=https://<domain>.
WEBCODER_DOMAIN=webcoder.example.com

# Supported MCP clients (built-in OAuth redirect rules): chatgpt, codex
WEBCODER_CLIENTS=chatgpt,codex

# Where the plain-HTTP port is published: 127.0.0.1 = this machine only, 0.0.0.0 = LAN
WEBCODER_BIND=127.0.0.1

TZ=Asia/Shanghai
